{
  "name": "deepl-mock",
  "description": "DeepL API mock server",
  "version": "1.21.0",
  "author": "DeepL SE <open-source@deepl.com>",
  "license": "MIT",
  "repository": "DeepLcom/deepl-mock",
  "homepage": "https://www.deepl.com/",
  "keywords": [
    "deepl",
    "http",
    "mock",
    "api"
  ],
  "dependencies": {
    "csv-parser": "^3.0.0",
    "express": "^5.2.1",
    "express-fileupload": "1.5.2",
    "express-openapi-validator": "^5.6.2",
    "http-proxy": "^1.18.1",
    "js-yaml": "^4.3.1",
    "morgan": "^1.10.0",
    "nocache": "^3.0.1",
    "qs": "~6.15.0"
  },
  "devDependencies": {
    "eslint": "^7.32.0",
    "eslint-config-airbnb-base": "^14.2.1",
    "eslint-plugin-import": "^2.25.4",
    "jest": "^30.3.0"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "auth.js",
    "CHANGELOG.md",
    "config/",
    "documents.js",
    "glossariesCsvParser.js",
    "glossariesV2.js",
    "glossariesV3.js",
    "languages.js",
    "LICENSE",
    "index.js",
    "README.md",
    "response-validator.js",
    "sessions.js",
    "styleRules.js",
    "translationMemories.js",
    "util.js",
    "writing_styles.js",
    "writing_tones.js"
  ],
  "scripts": {
    "start": "DEEPL_MOCK_SERVER_PORT=${DEEPL_MOCK_SERVER_PORT:-3000} DEEPL_MOCK_PROXY_SERVER_PORT=${DEEPL_MOCK_PROXY_SERVER_PORT:-3001} node index.js",
    "test": "jest",
    "lint": "eslint .",
    "lintfix": "eslint . --fix"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/test/*.test.js"],
    "testTimeout": 10000
  }
}
